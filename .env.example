# ==============================================================================
# GUIDE TOURISTIQUE BACKEND - ENVIRONMENT VARIABLES (SAMPLE)
# Duplicate this file to .env and set your local development passwords.
# NEVER commit the real .env file into Git repository!
# ==============================================================================

# Database Global Admin Credentials (used during PostgreSQL initialization)
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_admin_password
DB_HOST_PORT=15433

# Microservices Database Passwords
GUIDE_DB_PASSWORD=your_secure_guide_db_password
CIRCUIT_DB_PASSWORD=your_secure_circuit_db_password
RESERVATION_DB_PASSWORD=your_secure_reservation_db_password
AVIS_DB_PASSWORD=your_secure_avis_db_password

# Microservices Exposed Ports
GUIDE_HOST_PORT=8081
CIRCUIT_HOST_PORT=8082
RESERVATION_HOST_PORT=8083
AVIS_HOST_PORT=8084

# Keycloak / OAuth2 JWT Authentication
AUTH_ISSUER_URI=http://localhost:8180/realms/guide-touristique
AUTH_JWK_SET_URI=http://localhost:8180/realms/guide-touristique/protocol/openid-connect/certs
